# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data
.data/

# Not part of the app: agent tooling and skills that happen to live in the
# working tree. Listed here rather than excluded by hand at commit time, which
# is how skills/ reached the repo in the first place. The pull request template,
# issue templates, CI workflows and Dependabot config are the exceptions; a
# directory rule (.github/) could not be overridden.
.github/*
!.github/pull_request_template.md
!.github/workflows/
!.github/dependabot.yml
!.github/ISSUE_TEMPLATE/
skills/
skills-lock.json
.impeccable/


# Azure onboarding session artifacts (may hold deploy secrets)
.copilot-azure/

# Python bytecode from the renderers' shared modules
__pycache__/

# Environment-specific Azure parameters
infra/main.parameters.local.json
