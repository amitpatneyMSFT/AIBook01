# New here? You don't need to copy this whole file. First reuse or create a model
# endpoint (docs/install-guide.md, steps 1 and 2), then create a file named
# .env.local with just the few lines for it. Lines starting with # are ignored.
# ---------------------------------------------------------------------------
# Models at a glance. Only a chat model is required; the rest switch features on.
#   Chat .............. AZURE_OPENAI_DEPLOYMENT / AI_MODEL: chat, search, notes, Studio text formats
#   Studio script ..... AI_STUDIO_MODEL: audio, whiteboard, motion and training scripts (default: chat)
#   Embeddings ........ AZURE_OPENAI_EMBEDDING_DEPLOYMENT / AI_EMBEDDING_MODEL: semantic retrieval
#   Image ............. AZURE_OPENAI_IMAGE_DEPLOYMENT / AI_IMAGE_MODEL: AI-image infographics, videos
#   Vision ............ AZURE_OPENAI_VISION_DEPLOYMENT / AI_VISION_MODEL: image sources (default: chat)
#   Transcription ..... AZURE_OPENAI_TRANSCRIPTION_DEPLOYMENT / AI_TRANSCRIPTION_MODEL: audio/video sources
#   Realtime voice .... AZURE_OPENAI_REALTIME_DEPLOYMENT / AI_REALTIME_MODEL: live spoken discussions
#   Speech ............ AZURE_SPEECH_*: voices for audio overviews and videos, training avatars
#   Gemini ............ GEMINI_API_KEY: YouTube transcripts
# Full table: docs/configuration.md#models-and-what-theyre-used-for
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Model provider — pick ONE
# ---------------------------------------------------------------------------
# P) A named provider preset. Fills in the base URL and default models; set the
#    provider's usual key variable. AI_BASE_URL / AI_MODEL / AI_EMBEDDING_MODEL
#    still override the preset.
#    openai | anthropic | gemini | groq | mistral | deepseek | openrouter | xai |
#    perplexity | together | ollama | lmstudio | llamacpp | azure
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=                  # also used for YouTube transcripts (below)
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# XAI_API_KEY=
# PERPLEXITY_API_KEY=
# TOGETHER_API_KEY=
#
#    Embeddings and transcription can use a different provider from chat —
#    needed for chat-only providers such as Anthropic, DeepSeek or xAI.
# AI_EMBEDDING_PROVIDER=openai     # or AI_EMBEDDING_BASE_URL + AI_EMBEDDING_API_KEY
# AI_TRANSCRIPTION_PROVIDER=groq   # or AI_TRANSCRIPTION_BASE_URL + AI_TRANSCRIPTION_API_KEY
# AI_TRANSCRIPTION_MODEL=          # defaults to the preset's (whisper-1, whisper-large-v3)
#
# A) Any OpenAI-compatible endpoint: llama.cpp, Ollama, LM Studio, vLLM, OpenAI.
#    Setting AI_BASE_URL selects this and takes precedence over Azure below.
#
#    llama.cpp:  llama-server --port 8080 -m model.gguf --embeddings
# AI_BASE_URL=http://localhost:8080/v1
#    Ollama:     ollama serve
# AI_BASE_URL=http://localhost:11434/v1
#    LM Studio:
# AI_BASE_URL=http://localhost:1234/v1
#    OpenAI:
# AI_BASE_URL=https://api.openai.com/v1
#
# AI_MODEL=qwen3.5:latest
# AI_EMBEDDING_MODEL=nomic-embed-text
# AI_API_KEY=                      # only if the endpoint requires one
# AI_IMAGE_MODEL=                  # optional, for the "AI image" infographic style and videos
# AI_VISION_MODEL=                 # optional, reads uploaded images; defaults to AI_MODEL
#
# Note: chat and embeddings are separate models. llama.cpp needs --embeddings;
# Ollama needs a dedicated embedding model (ollama pull nomic-embed-text).
#
# B) Azure OpenAI (used when AI_BASE_URL is unset).
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# Data-plane API version — a dated Azure release, NOT a model version.
# Using a model version (e.g. gpt-5's "2025-08-07") causes a 404 on every call.
AZURE_OPENAI_API_VERSION=2024-10-21

# Deployment names as created in Azure AI Foundry / Azure OpenAI Studio
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Optional. Draws pictures for the "AI image" infographic style, whiteboard videos
# and motion explainers (backgrounds, character and props). gpt-image-2.5-sunburst
# is tuned for detail and text fidelity, which is what dense infographics need;
# gpt-image-2.5-flare is roughly 2.5x faster but lays out more like a slide.
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-2.5-sunburst
# API version used for image generation calls only.
# AZURE_OPENAI_IMAGE_API_VERSION=2025-04-01-preview

# Optional. Reads uploaded images so they can be indexed as sources. Defaults to
# the chat deployment, which only works if that model has vision — one without
# it invents a description rather than refusing, so set this explicitly when the
# chat model cannot see.
AZURE_OPENAI_VISION_DEPLOYMENT=gpt-5-mini

# Optional. Transcribes audio/video sources (whisper or gpt-4o-transcribe).
# AZURE_OPENAI_TRANSCRIPTION_DEPLOYMENT=whisper

# Optional. A realtime voice model for live discussions (Studio > Live
# discussion): gpt-realtime, gpt-realtime-2.1, gpt-realtime-mini... Global
# deployments are offered in East US 2 and Sweden Central. Any host of the
# resource works in AZURE_OPENAI_ENDPOINT; calls go to its openai.azure.com host.
# A new deployment can take about five minutes to accept calls.
# AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-2.1
# With AI_PROVIDER=openai instead of Azure (default gpt-realtime):
# AI_REALTIME_MODEL=gpt-realtime
# Shows what you say in the transcript; "off" to disable.
# AI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Characters of source text the AI starts each discussion with; it searches
# for anything more specific.
# DISCUSSION_CONTEXT_CHARS=16000

# Characters of source material sent to studio generation (~4 chars per token).
# Lower this if a small deployment quota causes repeated rate limiting; the app
# also halves it automatically and retries when it hits a 429.
# STUDIO_CONTEXT_CHARS=30000

# Optional. A different model for audio-overview, video and training scripts
# and scene plans; unset uses the chat model. AI_STUDIO_ENDPOINT points at a
# different Azure resource when the deployment lives elsewhere. For a Claude
# deployment in Microsoft Foundry, also set AI_STUDIO_API=anthropic (Claude
# accepts only the Messages API). See docs/configuration.md#studio-script-model.
# AI_STUDIO_MODEL=gpt-chat-latest
# AI_STUDIO_ENDPOINT=https://<other-resource>.cognitiveservices.azure.com
# AI_STUDIO_API=anthropic
# AI_STUDIO_BASE_URL=                # Messages API base URL, to override the derived one
# AI_STUDIO_API_KEY=                 # key for AI_STUDIO_ENDPOINT or AI_STUDIO_BASE_URL; Entra ID otherwise
# AI_STUDIO_MAX_TOKENS=16000

# ---------------------------------------------------------------------------
# Azure Speech (optional) — audio overviews, voice previews, whiteboard and
# motion narration, and training-video avatars (text-to-speech)
# ---------------------------------------------------------------------------
# An Azure AI Services (or Speech) resource. Entra auth needs the full resource
# id; the identity requires the "Cognitive Services Speech User" role.
# AZURE_SPEECH_REGION=eastus2
# AZURE_SPEECH_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<name>
#
# Or use a key instead of Entra:
# AZURE_SPEECH_KEY=

# ---------------------------------------------------------------------------
# Source discovery (optional)
# ---------------------------------------------------------------------------
# Discovery works with no key at all, via DuckDuckGo. Setting any of these
# switches to a higher-quality provider (first match wins, in this order).
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
# Google Programmable Search: needs BOTH a key and a search engine id. The
# YOUTUBE_API_KEY below is reused if GOOGLE_SEARCH_API_KEY is unset, provided
# the Custom Search API is enabled on that Cloud project.
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_CX=

# ---------------------------------------------------------------------------
# YouTube sources (optional — everything else works without these)
# ---------------------------------------------------------------------------
# Transcripts: YouTube's transcript endpoint is gated behind a proof-of-origin
# token and captions.download requires OAuth as the video's owner, so neither is
# reachable from a server. The Gemini API accepts a YouTube URL as a video input
# and fetches it on Google's own infrastructure, which is the supported route.
#
# This is NOT the same as a YouTube Data API key. Get one from Google AI Studio
# (aistudio.google.com/apikey), or enable the Generative Language API on the
# project your existing key belongs to.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
#
# Metadata: a Data API v3 key gives authoritative titles, channel, duration,
# description and the definitive caption-track list. It CANNOT return caption
# text. Without it the app falls back to oEmbed, which returns less.
# YOUTUBE_API_KEY=
#
# Fallback when Gemini is not configured or declines a video: the Cookie
# header from a signed-in youtube.com session, for networks where that is
# enough. This is a live session credential — use a throwaway account.
# YOUTUBE_COOKIE=
# YOUTUBE_CAPTION_LANG=en

# ---------------------------------------------------------------------------
# Whiteboard and motion videos (optional)
# ---------------------------------------------------------------------------
# Rendering needs Python with numpy, Pillow and imageio-ffmpeg, plus an image
# model and Azure Speech (above). Set this if `python` is not the right one.
# PYTHON_BIN=python3
# Background music for audio overviews and videos. Tracks are uploaded in the
# app (stored in .data/music); optionally also list a folder of tracks you have
# the rights to use (.mp3 .m4a .aac .wav .ogg .flac), read-only.
# MOTION_MUSIC_DIR=/path/to/music

# ---------------------------------------------------------------------------
# Training videos (optional) — Azure Speech text-to-speech avatar
# ---------------------------------------------------------------------------
# Uses the same Speech resource as audio overviews (above). The resource must be
# in an avatar region: East US 2, West US 2, South Central US, West Europe,
# North Europe, Sweden Central or Southeast Asia. "Cognitive Services Speech
# User" already includes the BatchAvatar data actions — Owner/Contributor do not.
#
# Entra needs the resource's custom-domain endpoint. It is derived from
# AZURE_SPEECH_RESOURCE_ID (https://<account>.cognitiveservices.azure.com); set
# this only if yours differs.
# AZURE_SPEECH_ENDPOINT=https://<account>.cognitiveservices.azure.com
#
# A public image URL to use behind the presenter instead of a solid color.
# AZURE_AVATAR_BACKGROUND_URL=
#
# Your avatar price per minute, in dollars. When set, the editor shows an
# estimated cost before you render. Check the Speech pricing page for your region.
# AZURE_AVATAR_PRICE_PER_MINUTE=
#
# Composed training videos render one avatar clip per section. How many run at
# once (default 2, at most 8). The S0 tier accepts about two new jobs a minute.
# AZURE_AVATAR_CONCURRENCY=2
#
# The live VASA-2 presenter (Training video > Options > Live) also needs
# AZURE_SPEECH_REGION set to West US 2, Central India, Southeast Asia or Sweden
# Central, the only regions where vasa-2 runs.
#
# Set to off to stop the training-video visual planner proposing AI images.
# TRAINING_IMAGES=on

# ---------------------------------------------------------------------------
# Authentication: Microsoft Entra ID (no API key required)
# ---------------------------------------------------------------------------
# Locally, just run `az login` — DefaultAzureCredential picks up that session.
# Your user needs the "Cognitive Services OpenAI User" role on the resource.
#
# On Azure (App Service, Container Apps, AKS, VM) enable a managed identity and
# grant it the same role; nothing below needs to be set.
#
# For a user-assigned managed identity, set only the client id:
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
#
# For an explicit service principal (CI pipelines, containers off-Azure):
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_SECRET=your-secret
#
# Optional legacy fallback — if set, key auth is used instead of Entra:
# AZURE_OPENAI_API_KEY=

# Optional: where the SQLite database lives (defaults to ./.data)
# DATA_DIR=./.data
# WAL (default) is fastest on a local disk. Use DELETE when DATA_DIR is on a
# network share such as an Azure Files volume.
# SQLITE_JOURNAL_MODE=WAL

# Optional: require a password for the UI (sign in at /login) and the API
# (Authorization: Bearer <password>). Off when unset.
# INFINIAIBOOK_PASSWORD=

# Optional, with a password: a separate bearer token for scripts
# Scripts should send this instead of the password.
# The password is not accepted as a bearer token.
# INFINIAIBOOK_API_TOKEN=

# Optional: extra key mixed into session-cookie signatures. Change it (or the
# password) to sign every browser out.
# INFINIAIBOOK_SESSION_SECRET=

# Optional. Set to true only to keep an old script that sends the password as
# its bearer token. Prefer INFINIAIBOOK_API_TOKEN.
# INFINIAIBOOK_ALLOW_PASSWORD_BEARER=false

# Daily ceiling on estimated model, speech and image spend, in US dollars.
# Unset: $25 when a cloud provider is configured, unlimited for a local model.
# 0 turns the ceiling off.
# DAILY_BUDGET_USD=25

# Optional: extra hostnames the server answers to, comma-separated ("*" for
# any). localhost, 127.0.0.1 and [::1] always work. Without a password, other
# hostnames are refused to block DNS-rebinding attacks from web pages.
# ALLOWED_HOSTS=notes.example.com,192.168.1.20

# Optional: set behind a reverse proxy so X-Forwarded-Host / X-Forwarded-Proto
# are trusted (same-origin checks and the Secure cookie flag).
# TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Fetching source URLs
# ---------------------------------------------------------------------------
# Links you add are fetched by the server, so the server's network position is
# what decides what they can reach. Addresses that resolve to this machine or a
# private network are refused, on every redirect hop rather than only on the
# address you typed — an ordinary-looking page is free to redirect inward.
#
# Turn this on only if you have an internal wiki or intranet you actually want
# to index, and only if you trust everyone who can add a source. It also opens
# up loopback and cloud metadata endpoints.
# ALLOW_PRIVATE_NETWORK_FETCH=false

# How much of a page or file will be read before giving up. Defaults to 25 MB.
# MAX_FETCH_BYTES=26214400

# Largest file (or request body) accepted when adding a source. Defaults to
# 50 MB. Checked before the upload is read into memory. Audio and video are
# still limited to 25 MB by the transcription API.
# MAX_UPLOAD_BYTES=52428800

# Uploaded ZIP archives: the most files imported from one archive (default 100)
# and the total size it may expand to, nested archives included (default 500 MB).
# Each file inside is also held to MAX_UPLOAD_BYTES.
# MAX_ARCHIVE_FILES=100
# MAX_ARCHIVE_EXPANDED_BYTES=524288000

# How many redirects to follow before refusing. Defaults to 5.
# FETCH_MAX_REDIRECTS=5

# How long to wait for a page to respond, in milliseconds. Defaults to 20000.
# FETCH_TIMEOUT_MS=20000
