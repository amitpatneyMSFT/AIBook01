    "url": "https://github.com/russrimm/InfiniAIBook/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "dev:lan": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "start:lan": "next start -H 0.0.0.0",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:ai": "tsx --env-file-if-exists=.env.local scripts/check-ai.ts",
    "check:ssrf": "tsx scripts/check-ssrf.ts",
    "check:motion": "tsx scripts/check-motion.ts",
    "check:training": "tsx scripts/check-training.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "cheerio": "^1.2.0",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.2",
    "microsoft-cognitiveservices-speech-sdk": "^1.52.0",
    "nanoid": "^6.0.1",
    "next": "15.5.25",
    "openai": "^7.15.0",
    "pptxgenjs": "^4.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "undici": "^7.29.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.28"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
