{
  "name": "infiniaibook",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted AI research notebook: chat with your sources, grounded in citations.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/russrimm/InfiniAIBook.git"
  },
  "homepage": "https://github.com/russrimm/InfiniAIBook#readme",
